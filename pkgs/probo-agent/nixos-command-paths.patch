diff --git a/pkg/deviceagent/checks/runcmd_paths_linux.go b/pkg/deviceagent/checks/runcmd_paths_linux.go
index b6ae4c8a..49f99bf2 100644
--- a/pkg/deviceagent/checks/runcmd_paths_linux.go

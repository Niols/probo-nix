+// linuxScreenLockProcess passes when the console user runs an idle screen
+// locker (xss-lock or xautolock), however it was started: from the window
+// manager's config, a systemd user service, an autostart entry, etc.
+func linuxScreenLockProcess(_ context.Context, user string) (Result, bool) {
+	idleMinutes, locker, mechanism, ok := linuxRunningIdleLock(linuxUserUID(user))
+	if !ok {
+		return Result{}, false
+	}
+
+	ev := map[string]any{
+		"backend":   "process",
+		"mechanism": mechanism,
+		"locker":    locker,
+	}
+	if user != "" {
+		ev["console_user"] = user
+	}
+
+	if idleMinutes >= 0 {
+		ev["idle_minutes"] = idleMinutes
+	}
+
+	return pass(ev), true
+}

+func TestLinuxRunningIdleLockIn(t *testing.T) {
+	t.Parallel()
+
+	writeProc := func(t *testing.T, root, pid string, args ...string) {
+		t.Helper()
+
+		dir := filepath.Join(root, pid)
+		require.NoError(t, os.MkdirAll(dir, 0o755))
+		require.NoError(t, os.WriteFile(
+			filepath.Join(dir, "cmdline"),
+			[]byte(strings.Join(args, "\x00")+"\x00"),
+			0o644,
+		))
+	}
+
+	uid := os.Getuid()
+
+	t.Run("xss-lock from a systemd user service", func(t *testing.T) {
+		t.Parallel()
+
+		root := t.TempDir()
+		writeProc(t, root, "12", "/nix/store/abc-bash/bin/bash")
+		writeProc(t, root, "34",
+			"/nix/store/abc-xss-lock/bin/xss-lock", "-s", "2", "--transfer-sleep-lock",
+			"--", "/nix/store/abc-i3lock/bin/i3lock", "--nofork",
+		)
+		require.NoError(t, os.MkdirAll(filepath.Join(root, "self"), 0o755))
+
+		_, locker, mechanism, ok := linuxRunningIdleLockIn(root, uid)
+		require.True(t, ok)
+		require.Equal(t, "xss-lock", mechanism)
+		require.Contains(t, locker, "i3lock")
+	})
+
+	t.Run("xautolock locking through loginctl", func(t *testing.T) {
+		t.Parallel()
+
+		root := t.TempDir()
+		writeProc(t, root, "56",
+			"/nix/store/abc-xautolock/bin/xautolock", "-time", "10",
+			"-locker", "/nix/store/abc-systemd/bin/loginctl lock-session 2",
+		)
+
+		idleMinutes, _, mechanism, ok := linuxRunningIdleLockIn(root, uid)
+		require.True(t, ok)
+		require.Equal(t, "xautolock", mechanism)
+		require.Equal(t, 10, idleMinutes)
+	})
+
+	t.Run("xss-lock without a locker", func(t *testing.T) {
+		t.Parallel()
+
+		root := t.TempDir()
+		writeProc(t, root, "78", "xss-lock", "--", "notify-send", "hello")
+
+		_, _, _, ok := linuxRunningIdleLockIn(root, uid)
+		require.False(t, ok)
+	})
+
+	t.Run("process of another user", func(t *testing.T) {
+		t.Parallel()
+
+		root := t.TempDir()
+		writeProc(t, root, "90", "xss-lock", "--", "i3lock")
+
+		_, _, _, ok := linuxRunningIdleLockIn(root, uid+1)
+		require.False(t, ok)
+	})
 }

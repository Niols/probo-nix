+// linuxUserUID returns the UID of user, or -1 if it cannot be found.
+func linuxUserUID(name string) int {
+	if name == "" {
+		return -1
+	}
+
+	u, err := user.Lookup(name)
+	if err != nil {
+		return -1
+	}
+
+	uid, err := strconv.Atoi(u.Uid)
+	if err != nil {
+		return -1
+	}
+
+	return uid
+}
+
+// linuxRunningIdleLock looks for an idle screen lock running as uid, for
+// any desktop and however it was started.
+func linuxRunningIdleLock(uid int) (idleMinutes int, locker, mechanism string, ok bool) {
+	return linuxRunningIdleLockIn("/proc", uid)
+}
+
+// linuxRunningIdleLockIn scans the processes under procRoot owned by uid and
+// accepts the same xautolock and xss-lock invocations as the i3 config check.
+func linuxRunningIdleLockIn(procRoot string, uid int) (idleMinutes int, locker, mechanism string, ok bool) {
+	idleMinutes = -1
+
+	if uid < 0 {
+		return idleMinutes, "", "", false
+	}
+
+	entries, err := os.ReadDir(procRoot)
+	if err != nil {
+		return idleMinutes, "", "", false
+	}
+
+	for _, entry := range entries {
+		if _, err := strconv.Atoi(entry.Name()); err != nil {
+			continue
+		}
+
+		dir := filepath.Join(procRoot, entry.Name())
+
+		info, err := os.Stat(dir)
+		if err != nil {
+			continue
+		}
+
+		stat, isStat := info.Sys().(*syscall.Stat_t)
+		if !isStat || int(stat.Uid) != uid {
+			continue
+		}
+
+		cmdline, err := os.ReadFile(filepath.Join(dir, "cmdline"))
+		if err != nil || len(cmdline) == 0 {
+			continue
+		}
+
+		args := strings.Split(strings.TrimRight(string(cmdline), "\x00"), "\x00")
+		if len(args) == 0 {
+			continue
+		}
+
+		switch filepath.Base(args[0]) {
+		case "xautolock":
+			if minutes, lockCmd, found := parseXautolockIdleLock(strings.Join(args, " ")); found {
+				return minutes, lockCmd, "xautolock", true
+			}
+		case "xss-lock":
+			if lockCmd, found := parseXssLockIdleLock(strings.Join(args, " ")); found {
+				return -1, lockCmd, "xss-lock", true
+			}
+		}
+	}
+
+	return idleMinutes, "", "", false
+}
